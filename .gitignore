# ==============================================================================
# MR SAQIB MD :: Production .gitignore for GitHub & Railway Deployment
# ==============================================================================

# 1. WHATSAPP SENSITIVE AUTH & SESSIONS (CRITICAL: NEVER COMMIT TO GIT!)
auth_info/
auth_info*/
sessions/
session/
data/sessions/
*creds.json
*_backup_*
*_expired_*
*.session
baileys_store.json

# 2. ENVIRONMENT SECRETS & API KEYS
.env
.env.local
.env.development
.env.test
.env.production
*.env
!.env.example

# 3. NODE & NPM DEPENDENCIES
node_modules/
pnpm-lock.yaml
pnpm-workspace.yaml
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 4. RUNTIME USER DATA & DOWNLOADED MEDIA
data/stickers/
data/saved_stickers.json
data/bot_data.json
data/channel_arc.json
data/polls.json
data/autoread.json
data/messageLogs/
database/*.json

# 5. TEMPORARY MEDIA & CACHES
tmp/
temp/
database/channel_media/
test_*.jpg
test_*.png
test_welcome.js
*.tmp
*.log
*.bak
*.swp
*.patch

# 6. OPERATING SYSTEM & EDITOR FILES
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

.idea/
.vscode/
*.sublime-project
*.sublime-workspace
