{
  "version": 2,
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://web-production-08da5300.up.railway.app/api/:match*"
    },
    {
      "source": "/socket.io/:match*",
      "destination": "https://web-production-08da5300.up.railway.app/socket.io/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
