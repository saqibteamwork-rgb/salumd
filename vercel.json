{
  "version": 2,
  "framework": null,
  "buildCommand": "echo 'Static build'",
  "installCommand": "echo 'No install needed'",
  "outputDirectory": ".",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api",
      "destination": "https://web-production-f30a34e9.up.railway.app/api"
    },
    {
      "source": "/api/:match*",
      "destination": "https://web-production-f30a34e9.up.railway.app/api/:match*"
    },
    {
      "source": "/socket.io",
      "destination": "https://web-production-f30a34e9.up.railway.app/socket.io"
    },
    {
      "source": "/socket.io/:match*",
      "destination": "https://web-production-f30a34e9.up.railway.app/socket.io/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
